# Hyperliquid public Info API
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info

# Telegram secrets (set actual values in GitHub Actions Secrets; do not commit real tokens)
TELEGRAM_TOKEN=
NOVARA_FREE_CHAT_ID=
NOVARA_VIP_CHAT_ID=

# Signal filters
NOVARA_SMART_MIN_24H_VOLUME_USD=2000000
NOVARA_SMART_MAX_MARKETS=300
NOVARA_SMART_MIN_SCORE=5.8
NOVARA_VIP_MIN_SCORE=6.0
NOVARA_SMART_MIN_RR=1.65
NOVARA_SMART_MAX_SPREAD_PCT=0.25
NOVARA_SMART_MAX_SIGNALS_PER_CYCLE=8
