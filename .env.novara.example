# Copy to /etc/novara/novara.env and replace all placeholders.
TELEGRAM_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
NOVARA_FREE_CHAT_ID=
NOVARA_VIP_CHAT_ID=REPLACE_WITH_VIP_CHAT_ID

# TradingView webhook listener. Keep the listener bound to localhost behind HTTPS reverse proxy.
NOVARA_TV_WEBHOOK_HOST=127.0.0.1
NOVARA_TV_WEBHOOK_PORT=8787
NOVARA_TV_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
NOVARA_TV_LEVELS_FILE=/opt/novara/production/state/tradingview_signals.json

# Scanner settings: scans the highest-volume eligible markets up to the cap.
NOVARA_SMART_MAX_MARKETS=500
NOVARA_SMART_MIN_SCORE=6.0
NOVARA_SMART_MIN_RR=1.8
NOVARA_SMART_MIN_24H_VOLUME_USD=2000000
NOVARA_BTC_COUNTERTREND_HARD_MOVE_PCT=1.5
NOVARA_TV_MAX_AGE_MS=1200000
NOVARA_TV_MAX_DRIFT_PCT=0.65
# Start false to keep broad signal discovery; set true after creating TradingView alerts for all target markets.
NOVARA_TV_REQUIRE_LEVELS=false
NOVARA_SMART_MONEY_STATE_FILE=/opt/novara/production/state/novara_smart_money_state.json
